// Add these new models at the bottom:

// ─── Application Builder ────────────────────────────────────────────────────

model Application {
  id              String   @id @default(uuid())

  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Job details
  jobTitle        String
  band            String?
  employer        String?
  sourceUrl       String?
  jobDescription  String   @db.LongText
  personSpec      String?  @db.LongText

  // Parsed specification (JSON output from parser)
  // { essentialCriteria: [...], desirableCriteria: [...], nhsValues: [...] }
  parsedSpec      Json?

  // User's background context
  cvText          String?  @db.LongText
  yearsExperience Int?
  currentBand     Int?
  currentRole     String?

  // Generated outputs
  introduction    String?  @db.LongText
  closing         String?  @db.LongText
  fullStatement   String?  @db.LongText
  wordCount       Int?

 notes           String?  @db.LongText
  submittedAt     DateTime?
  interviewDate   DateTime?
  deadlineDate    DateTime?
  cvScore         Json?
  shortlistAssessment  Json?

  // Scoring
  liveScore       Json?    // { overall, criteria, evidence, values, realism, language }
  completeness    Float    @default(0) // 0-100 percentage of criteria addressed

  // Status
  status          String   @default("draft") // draft | in_progress | complete | exported

  criteria        ApplicationCriterion[]
  drafts          ApplicationDraft[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model ApplicationCriterion {
  id              String   @id @default(uuid())

  applicationId   String
  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  // Criterion details (from parsed spec)
  criterionText   String   @db.LongText
  type            String   // essential | desirable
  category        String?  // clinical | leadership | values | qualification | experience
  order           Int      @default(0)

  // User's STAR evidence
  situation       String?  @db.LongText
  task            String?  @db.LongText
  action          String?  @db.LongText
  result          String?  @db.LongText

  // Optional enhancements
  metrics         String?  // quantifiable outcomes
  mdtContext      String?  // multidisciplinary team context
  reflection      String?  @db.LongText // what you learned
  nhsValues       String?  // which NHS values this demonstrates

  // AI-generated output
  generatedParagraph String? @db.LongText
  paragraphScore     Int?   // 0-100

  // Status
  status          String   @default("pending") // pending | drafted | reviewed | approved

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([applicationId])
  @@index([type])
}

model ApplicationDraft {
  id              String   @id @default(uuid())

  applicationId   String
  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  version         Int      @default(1)
  content         String   @db.LongText
  wordCount       Int?
  score           Json?
  feedback        String?  @db.LongText

  createdAt       DateTime @default(now())

  @@index([applicationId])
}
