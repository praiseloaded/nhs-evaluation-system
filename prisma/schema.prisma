generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  password      String?
  emailVerified DateTime?
  image         String?
  dbShard       String    @default("primary")

  tier          String    @default("free")
  analysisUsed  Int       @default(0)
  analysisLimit Int       @default(1)
  careerGpsData Json?

  abTests           ABTest[]
  criteriaExplorers CriteriaExplorer[]

  evidenceEntries   EvidenceEntry[]
  certificates      Certificate[]
  competencies      Competency[]
  interviewVault    InterviewVaultEntry[]
  referenceEntries  ReferenceEntry[]

  accounts      Account[]
  sessions      Session[]
  analyses      Analysis[]
  interviews    Interview[]
  applications  Application[]
  cvProfiles    CvProfile[]

  mentorshipThreads MentorshipThread[]

  stripeCustomerId     String?
  stripeSubscriptionId String?

  role            String    @default("user")
  suspended       Boolean   @default(false)
  suspendedAt     DateTime?
  suspendedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  adminId     String
  adminEmail  String
  action      String
  targetType  String
  targetId    String?
  targetEmail String?
  before      Json?
  after       Json?
  notes       String?  @db.Text
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([adminId])
  @@index([targetId])
  @@index([createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String

  refresh_token String?
  access_token  String?
  expires_at    Int?
  token_type    String?
  scope         String?
  id_token      String?
  session_state String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model SystemEvent {
  id           String   @id @default(cuid())
  type         String
  provider     String?
  userId       String?
  endpoint     String?
  statusCode   Int?
  durationMs   Int?
  errorMessage String?  @db.Text
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([type])
  @@index([createdAt])
  @@index([userId])
}

model ImpersonationSession {
  id           String    @id @default(cuid())
  adminId      String
  targetUserId String
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  reason       String?

  @@index([adminId])
  @@index([targetUserId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Analysis {
  id                String @id @default(uuid())

  userId            String
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  jobTitle          String
  jobDescription    String
  personSpec        String
  essentialCriteria String
  desirableCriteria String
  skills            String
  values            String
  sourceUrl         String?

  cv        String?
  statement String?

  result               Json
  keywordIntel         Json?
  evidenceGaps         Json?
  interviews           Interview[]
  interviewProbability Json?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model Interview {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  analysisId String
  analysis   Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  jobTitle String
  band     String?

  panellists Json
  questions  Json

  status    String @default("pending")
  totalScore Int?
  feedback  Json?

  answers InterviewAnswer[]

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([analysisId])
  @@index([status])
}

model InterviewAnswer {
  id String @id @default(uuid())

  interviewId String
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  questionId  String
  panellistId String

  audioUrl   String?
  transcript String?

  score      Int?
  evaluation Json?

  answeredAt DateTime @default(now())

  @@index([interviewId])
  @@index([questionId])
}

model Application {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  jobTitle       String
  band           String?
  employer       String?
  sourceUrl      String?
  jobDescription String?
  personSpec     String?

  parsedSpec Json?

  cvText        String?
  nhsValuesText String?
  yearsExperience Int?
  currentBand     Int?
  currentRole     String?

  introduction  String?
  closing       String?
  fullStatement String?
  wordCount     Int?

  outcome      String?
  outcomeDate  DateTime?
  outcomeNotes String?  @db.Text

  statementQ1 String?
  statementQ2 String?
  statementQ3 String?
  wordCountQ1 Int?
  wordCountQ2 Int?
  wordCountQ3 Int?
  q3Context   Json?

  notes           String?
  submittedAt     DateTime?
  interviewDate   DateTime?
  deadlineDate    DateTime?
  cvScore         Json?
  shortlistAssessment Json?
  liveScore       Json?
  completeness    Float   @default(0)
  status          String  @default("draft")

  criteria ApplicationCriterion[]
  drafts   ApplicationDraft[]

  deadlineReminderSent Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model ApplicationCriterion {
  id String @id @default(uuid())

  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  criterionText String
  type          String
  category      String?
  order         Int    @default(0)

  situation String?
  task      String?
  action    String?
  result    String?

  metrics    String?
  mdtContext String?
  reflection String?
  nhsValues  String?

  generatedParagraph String?
  paragraphScore     Int?

  status String @default("pending")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([applicationId])
  @@index([type])
}

model ApplicationDraft {
  id String @id @default(uuid())

  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  version   Int    @default(1)
  content   String
  wordCount Int?
  score     Json?
  feedback  String?

  createdAt DateTime @default(now())

  @@index([applicationId])
}

model EvidenceEntry {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title    String
  category String
  situation String @db.Text
  task      String @db.Text
  action    String @db.Text
  result    String @db.Text

  skillTags    String[]
  nhsValueTags String[]

  dateOccurred DateTime?
  employer     String?
  usageCount   Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([category])
}

model Certificate {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name       String
  issuer     String?
  certNumber String?
  dateIssued DateTime?
  expiryDate DateTime?
  fileUrl    String?
  category   String @default("training")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Competency {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  skillName     String
  status        String   @default("training")
  evidenceId    String?
  notes         String?  @db.Text
  signedOffBy   String?
  signedOffDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@unique([userId, skillName])
}

model InterviewVaultEntry {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  question         String @db.Text
  category         String @default("general")
  answer           String @db.Text
  linkedEvidenceId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model ReferenceEntry {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  employer         String
  jobTitle         String
  startDate        DateTime?
  endDate          DateTime?
  responsibilities String  @db.Text
  achievements     String? @db.Text

  refereeName  String?
  refereeRole  String?
  refereeEmail String?
  refereePhone String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model CvProfile {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title    String @default("My CV")
  template String @default("clinical")

  fullName                 String?
  email                    String?
  phone                    String?
  location                 String?
  professionalRegistration String?

  personalStatement String?  @db.Text
  workExperience    Json?
  education         Json?
  skills            Json?
  certifications    Json?
  additionalInfo    String?  @db.Text
  references        Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminNote {
  id         String   @id @default(cuid())
  userId     String
  adminId    String
  adminEmail String
  body       String   @db.Text
  pinned     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model Notification {
  id      String  @id @default(cuid())
  userId  String
  type    String
  title   String
  body    String?
  linkUrl String?
  read    Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, read])
  @@index([createdAt])
}

model NotificationPreference {
  id     String  @id @default(cuid())
  userId String
  type   String
  muted  Boolean @default(true)

  @@unique([userId, type])
  @@index([userId])
}

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  label       String
  description String?
  minTier     String   @default("free")
  enabled     Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}

model TierLimit {
  id    String @id @default(cuid())
  tier  String
  key   String
  value Int
  updatedAt DateTime @updatedAt

  @@unique([tier, key])
}

model MentorshipThread {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject       String
  status        String   @default("open")
  lastMessageAt DateTime @default(now())
  unreadByUser  Boolean  @default(false)
  messages      MentorshipMessage[]
  createdAt     DateTime @default(now())

  @@index([userId])
}

model MentorshipMessage {
  id         String           @id @default(cuid())
  threadId   String
  thread     MentorshipThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  fromAdmin  Boolean          @default(false)
  senderType String           @default("user")
  body       String           @db.Text
  createdAt  DateTime         @default(now())

  @@index([threadId])
}

model ABTest {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  jobTitle   String
  jobSpec    String @db.Text
  statementA String @db.Text
  statementB String @db.Text

  scoreA Int     @default(0)
  scoreB Int     @default(0)
  winner String?

  resultA    Json?
  resultB    Json?
  comparison Json?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model CriteriaExplorer {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  jobTitle String
  jobSpec  String  @db.Text
  cvText   String? @db.Text

  result Json?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}
