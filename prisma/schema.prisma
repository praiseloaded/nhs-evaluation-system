generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  password      String?
  emailVerified DateTime?
  image         String?

  tier          String    @default("free")
  analysisUsed  Int       @default(0)
  analysisLimit Int       @default(1)

  accounts      Account[]
  sessions      Session[]
  analyses      Analysis[]
  interviews    Interview[]
  applications  Application[]

  stripeCustomerId     String?
  stripeSubscriptionId String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String

  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Analysis {
  id                String   @id @default(uuid())

  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  jobTitle          String
  jobDescription    String
  personSpec        String
  essentialCriteria String
  desirableCriteria String
  skills            String
  values            String
  sourceUrl         String?

  cv                String?
  statement         String?

  result            Json

  interviews        Interview[]

  createdAt         DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model Interview {
  id          String   @id @default(uuid())

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  analysisId  String
  analysis    Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  jobTitle    String
  band        String?

  panellists  Json
  questions   Json

  status      String   @default("pending")
  totalScore  Int?
  feedback    Json?

  answers     InterviewAnswer[]

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([analysisId])
  @@index([status])
}

model InterviewAnswer {
  id            String   @id @default(uuid())

  interviewId   String
  interview     Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  questionId    String
  panellistId   String

  audioUrl      String?
  transcript    String?

  score         Int?
  evaluation    Json?

  answeredAt    DateTime  @default(now())

  @@index([interviewId])
  @@index([questionId])
}

model Application {
  id              String   @id @default(uuid())

  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ── Job details ───────────────────────────────────────────────────────────
  jobTitle        String
  band            String?
  employer        String?
  sourceUrl       String?
  jobDescription  String
  personSpec      String?   // person spec stored separately from job description

  parsedSpec      Json?     // AI-extracted criteria, nation, word limits, q3 triggers

  // ── Applicant context ─────────────────────────────────────────────────────
  cvText          String?
  nhsValuesText   String?   // uploaded Trust/Board values document — used in Q2
  yearsExperience Int?
  currentBand     Int?
  currentRole     String?

  // ── Legacy single-statement fields (kept for backwards compatibility) ─────
  introduction    String?
  closing         String?
  fullStatement   String?
  wordCount       Int?

  // ── Three-question statement fields (Scotland = 3 separate boxes) ─────────
  // For England/Wales/NI these are the three sections combined into one paste
  statementQ1     String?   // Q1: Why are you suitable? (suitability + STAR evidence)
  statementQ2     String?   // Q2: Why do you want to work here? (values + employer-specific)
  statementQ3     String?   // Q3: Any other relevant information? (gaps, GIS, relocation etc.)
  wordCountQ1     Int?
  wordCountQ2     Int?
  wordCountQ3     Int?
  q3Context       Json?     // stores career gap, GIS, relocation, part-time flags

  // ── Tracker fields ────────────────────────────────────────────────────────
  notes           String?
  submittedAt     DateTime?
  interviewDate   DateTime?
  deadlineDate    DateTime?
  cvScore         Json?
  shortlistAssessment Json?
  liveScore       Json?
  completeness    Float    @default(0)
  status          String   @default("draft")

  criteria        ApplicationCriterion[]
  drafts          ApplicationDraft[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model ApplicationCriterion {
  id              String   @id @default(uuid())

  applicationId   String
  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  criterionText   String
  type            String
  category        String?
  order           Int      @default(0)

  situation       String?
  task            String?
  action          String?
  result          String?

  metrics         String?
  mdtContext      String?
  reflection      String?
  nhsValues       String?

  generatedParagraph String?
  paragraphScore     Int?

  status          String   @default("pending")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([applicationId])
  @@index([type])
}

model ApplicationDraft {
  id              String   @id @default(uuid())

  applicationId   String
  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  version         Int      @default(1)
  content         String
  wordCount       Int?
  score           Json?
  feedback        String?

  createdAt       DateTime @default(now())

  @@index([applicationId])
}
