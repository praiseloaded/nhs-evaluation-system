generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  password      String?
  emailVerified DateTime?
  image         String?

  // SaaS billing fields
  tier          String    @default("free") // free | pro | elite
  analysisUsed  Int       @default(0)
  analysisLimit Int       @default(1)

  // relations
  accounts      Account[]
  sessions      Session[]
  analyses      Analysis[]
  interviews    Interview[]
  applications  Application[] // ← ADD THIS LINE ONLY

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String

  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Analysis {
  id                String   @id @default(uuid())

  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  jobTitle          String
  jobDescription    String   @db.LongText
  personSpec        String   @db.LongText
  essentialCriteria String   @db.LongText
  desirableCriteria String   @db.LongText
  skills            String   @db.LongText
  values            String   @db.LongText
  sourceUrl         String?

  cv                String?  @db.LongText
  statement         String?  @db.LongText

  result            Json

  interviews        Interview[]

  createdAt         DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// ─── Interview Simulator ────────────────────────────────────────────────────

model Interview {
  id          String   @id @default(uuid())

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  analysisId  String
  analysis    Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  jobTitle    String
  band        String?

  // Panel config — stored as JSON
  // [{ id, name, role, avatar, specialty }]
  panellists  Json

  // Generated questions — stored as JSON
  // [{ id, panellistId, question, category, followUp? }]
  questions   Json

  // Overall status
  status      String   @default("pending") // pending | in_progress | completed
  totalScore  Int?
  feedback    Json?    // overall interview feedback from AI

  answers     InterviewAnswer[]

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([analysisId])
  @@index([status])
}

model InterviewAnswer {
  id            String   @id @default(uuid())

  interviewId   String
  interview     Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  questionId    String    // references question.id from Interview.questions JSON
  panellistId   String    // which panellist asked this

  // User's response
  audioUrl      String?   // optional: stored audio URL
  transcript    String?   @db.LongText  // transcribed text

  // AI evaluation
  score         Int?      // 0-100
  evaluation    Json?     // { score, strengths, gaps, starRating, panellistNotes }

  answeredAt    DateTime  @default(now())

  @@index([interviewId])
  @@index([questionId])
}


