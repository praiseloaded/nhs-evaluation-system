generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  password      String?
  emailVerified DateTime?
  image         String?
  dbShard  String  @default("primary")  

  tier          String    @default("free")
  analysisUsed  Int       @default(0)
  analysisLimit Int       @default(1)
  careerGpsData   Json?


  evidenceEntries   EvidenceEntry[]
  certificates      Certificate[]
  competencies      Competency[]
  interviewVault    InterviewVaultEntry[]
  referenceEntries  ReferenceEntry[]


  accounts      Account[]
  sessions      Session[]
  analyses      Analysis[]
  interviews    Interview[]
  applications  Application[]
  cvProfiles      CvProfile[]

  stripeCustomerId     String?
  stripeSubscriptionId String?

mentorshipThreads MentorshipThread[]

  role            String    @default("user")   // 'user' | 'admin'
  suspended       Boolean   @default(false)
  suspendedAt     DateTime?
  suspendedReason String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}


model AdminAuditLog {
  id          String   @id @default(cuid())
  adminId     String
  adminEmail  String                          // denormalised so log survives admin deletion
  action      String                          // 'tier_change' | 'suspend' | 'unsuspend' | 'delete_user' | 'impersonate' | 'refund' | 'edit_record'
  targetType  String                          // 'user' | 'analysis' | 'application' | 'cvProfile' | 'subscription'
  targetId    String?
  targetEmail String?
  before      Json?                           // snapshot before change
  after       Json?                           // snapshot after change
  notes       String?  @db.Text
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([adminId])
  @@index([targetId])
  @@index([createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String

  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}


model SystemEvent {
  id         String   @id @default(cuid())
  type       String                           // 'ai_call' | 'ai_error' | 'api_error' | 'scrape_failure' | 'payment_event'
  provider   String?                          // 'gemini' | 'groq' | 'stripe' | 'nhs_jobs' | 'ukvi_register'
  userId     String?
  endpoint   String?                          // e.g. '/api/analysis', '/api/cv/[id]/export'
  statusCode Int?
  durationMs Int?
  errorMessage String? @db.Text
  metadata   Json?                            // free-form: tokens used, model name, etc.
  createdAt  DateTime @default(now())

  @@index([type])
  @@index([createdAt])
  @@index([userId])
}

model ImpersonationSession {
  id         String    @id @default(cuid())
  adminId    String
  targetUserId String
  startedAt  DateTime  @default(now())
  endedAt    DateTime?
  reason     String?

  @@index([adminId])
  @@index([targetUserId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Analysis {
  id                String   @id @default(uuid())

  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  jobTitle          String
  jobDescription    String
  personSpec        String
  essentialCriteria String
  desirableCriteria String
  skills            String
  values            String
  sourceUrl         String?

  cv                String?
  statement         String?

  result            Json
  keywordIntel      Json?
  evidenceGaps      Json?
  interviews        Interview[]
  interviewProbability  Json?  

  createdAt         DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model Interview {
  id          String   @id @default(uuid())

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  analysisId  String
  analysis    Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  jobTitle    String
  band        String?

  panellists  Json
  questions   Json

  status      String   @default("pending")
  totalScore  Int?
  feedback    Json?

  answers     InterviewAnswer[]

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([analysisId])
  @@index([status])
}

model InterviewAnswer {
  id            String   @id @default(uuid())

  interviewId   String
  interview     Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  questionId    String
  panellistId   String

  audioUrl      String?
  transcript    String?

  score         Int?
  evaluation    Json?

  answeredAt    DateTime  @default(now())

  @@index([interviewId])
  @@index([questionId])
}

model Application {
  id              String   @id @default(uuid())

  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ── Job details ───────────────────────────────────────────────────────────
  jobTitle        String
  band            String?
  employer        String?
  sourceUrl       String?
  jobDescription  String
  personSpec      String?   // person spec stored separately from job description

  parsedSpec      Json?     // AI-extracted criteria, nation, word limits, q3 triggers

  // ── Applicant context ─────────────────────────────────────────────────────
  cvText          String?
  nhsValuesText   String?   // uploaded Trust/Board values document — used in Q2
  yearsExperience Int?
  currentBand     Int?
  currentRole     String?

  // ── Legacy single-statement fields (kept for backwards compatibility) ─────
  introduction    String?
  closing         String?
  fullStatement   String?
  wordCount       Int?

  outcome         String?   // 'pending' | 'shortlisted' | 'interview' | 'offer' | 'rejected' | 'withdrawn'
  outcomeDate     DateTime?
  outcomeNotes    String?   @db.Text

  // ── Three-question statement fields (Scotland = 3 separate boxes) ─────────
  // For England/Wales/NI these are the three sections combined into one paste
  statementQ1     String?   // Q1: Why are you suitable? (suitability + STAR evidence)
  statementQ2     String?   // Q2: Why do you want to work here? (values + employer-specific)
  statementQ3     String?   // Q3: Any other relevant information? (gaps, GIS, relocation etc.)
  wordCountQ1     Int?
  wordCountQ2     Int?
  wordCountQ3     Int?
  q3Context       Json?     // stores career gap, GIS, relocation, part-time flags

  // ── Tracker fields ────────────────────────────────────────────────────────
  notes           String?
  submittedAt     DateTime?
  interviewDate   DateTime?
  deadlineDate    DateTime?
  cvScore         Json?
  shortlistAssessment Json?
  liveScore       Json?
  completeness    Float    @default(0)
  status          String   @default("draft")

  criteria        ApplicationCriterion[]
  drafts          ApplicationDraft[]

  deadlineReminderSent Boolean @default(false)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model ApplicationCriterion {
  id              String   @id @default(uuid())

  applicationId   String
  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  criterionText   String
  type            String
  category        String?
  order           Int      @default(0)

  situation       String?
  task            String?
  action          String?
  result          String?

  metrics         String?
  mdtContext      String?
  reflection      String?
  nhsValues       String?

  generatedParagraph String?
  paragraphScore     Int?

  status          String   @default("pending")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([applicationId])
  @@index([type])
}

model ApplicationDraft {
  id              String   @id @default(uuid())

  applicationId   String
  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  version         Int      @default(1)
  content         String
  wordCount       Int?
  score           Json?
  feedback        String?

  createdAt       DateTime @default(now())

  @@index([applicationId])
}

model EvidenceEntry {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  title         String              // short label, e.g. "Dementia patient research visit"
  category      String              // clinical | patient_interaction | research | audit | training | leadership | other
  situation     String   @db.Text
  task          String   @db.Text
  action        String   @db.Text
  result        String   @db.Text

  skillTags     String[]            // e.g. ["venepuncture", "consent", "communication"]
  nhsValueTags  String[]            // e.g. ["Care and Compassion", "Dignity and Respect"]

  dateOccurred  DateTime?
  employer      String?             // where this happened
  usageCount    Int      @default(0) // how many times used in statements

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([category])
}

model Certificate {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name          String              // e.g. "Phlebotomy Certificate"
  issuer        String?             // e.g. "Skills for Health"
  certNumber    String?
  dateIssued    DateTime?
  expiryDate    DateTime?
  fileUrl       String?             // uploaded document link
  category      String   @default("training") // training | mandatory | professional_registration | qualification

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

model Competency {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  skillName     String              // e.g. "Venepuncture"
  status        String   @default("training") // competent | training | not_started
  evidenceId    String?             // optional link to EvidenceEntry
  notes         String?  @db.Text
  signedOffBy   String?             // assessor name
  signedOffDate DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@unique([userId, skillName])
}

model InterviewVaultEntry {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  question      String   @db.Text   // e.g. "Tell us about yourself"
  category      String   @default("general") // general | teamwork | difficult_situation | values | leadership | clinical
  answer        String   @db.Text
  linkedEvidenceId String?          // optional link to EvidenceEntry used for this answer

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

model ReferenceEntry {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  employer        String
  jobTitle        String
  startDate       DateTime?
  endDate         DateTime?         // null = current role
  responsibilities String  @db.Text
  achievements    String?  @db.Text

  refereeName     String?
  refereeRole     String?
  refereeEmail    String?
  refereePhone    String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
}


model CvProfile {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String   @default("My CV")        // user-facing label, e.g. "Nursing CV"
  template    String   @default("clinical")      // 'clinical' | 'nonClinical' | 'newToNhs'

  // Personal details
  fullName    String?
  email       String?
  phone       String?
  location    String?
  professionalRegistration String?  // e.g. NMC PIN, HCPC number — shown if present

  // Sections stored as JSON — flexible, ordered arrays
  personalStatement String?  @db.Text
  workExperience    Json?    // [{ jobTitle, employer, location, startDate, endDate, current, bullets: string[] }]
  education         Json?    // [{ qualification, institution, location, startDate, endDate, grade }]
  skills            Json?    // [{ category, items: string[] }] or string[]
  certifications    Json?    // [{ name, issuer, date, expiryDate }]
  additionalInfo    String?  @db.Text
  references        Json?    // [{ name, role, organisation, relationship, email, phone }] — usually "available on request"

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


model AdminNote {
  id          String   @id @default(cuid())
  userId      String                          // the user this note is about
  adminId     String
  adminEmail  String
  body        String   @db.Text
  pinned      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model Notification {
  id          String   @id @default(cuid())
  userId      String                          // recipient
  type        String                          // 'mentorship_reply' | 'mentorship_thread_closed' | 'account_tier_changed' | 'account_suspended' | 'account_unsuspended' | future types
  title       String
  body        String?
  linkUrl     String?                         // where clicking the notification should go
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([userId, read])
  @@index([createdAt])
}

model NotificationPreference {
  id        String   @id @default(cuid())
  userId    String
  type      String                            // matches Notification.type
  muted     Boolean  @default(true)            // a row only exists when muted=true in practice

  @@unique([userId, type])
  @@index([userId])
}


model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique                // e.g. 'mentorship', 'interview_simulator', 'career_gps'
  label       String                           // display name for the admin settings grid
  description String?
  minTier     String   @default("free")        // 'free' | 'pro' | 'elite'
  enabled     Boolean  @default(true)          // global kill switch, independent of tier
  updatedAt   DateTime @updatedAt
}

model TierLimit {
  id        String   @id @default(cuid())
  tier      String                             // 'free' | 'pro' | 'elite'
  key       String                             // e.g. 'analysisLimit', 'cvProfileLimit', 'evidenceEntryLimit'
  value     Int                                // -1 means unlimited
  updatedAt DateTime @updatedAt

  @@unique([tier, key])
}


model MentorshipThread {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject       String
  status        String    @default("open")
  lastMessageAt DateTime  @default(now())
    unreadByUser  Boolean   @default(false)   // ← add this
  messages      MentorshipMessage[]
  createdAt     DateTime  @default(now())

  @@index([userId])
}

model MentorshipMessage {
  id        String   @id @default(cuid())
  threadId  String
  thread    MentorshipThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  fromAdmin Boolean  @default(false)
    senderType  String   @default("user")    // ← add this ('user' | 'admin')
  body      String   @db.Text
  createdAt DateTime @default(now())

  @@index([threadId])
}